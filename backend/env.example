PORT=3000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/financily
CLIENT_ORIGIN=https://your-site.vercel.app,https://financily-94e0.onrender.com
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=change-this-strong-password
NODE_ENV=production

# --- Email OTP + alerts (recommended on Render): Brevo HTTP API ---
# 1. Create a free account at brevo.com
# 2. Settings > Senders & IP > add and VERIFY your sender email
# 3. SMTP & API > API Keys > create a key (starts with xkeysib-)
BREVO_API_KEY=
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME=Financily
NOTIFY_EMAIL=

# --- Optional SMS OTP (Fast2SMS) ---
FAST2SMS_KEY=

# --- Optional SMTP fallback (blocked on Render free tier; fine locally / paid hosts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
