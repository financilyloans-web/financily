# ============================================================================
# FINANCILY — Render environment file (TEMPLATE / no real secrets)
# ============================================================================
# This is a TEMPLATE. Every value below is a PLACEHOLDER or empty on purpose.
# It contains NO real credentials. Copy it to `.env.render` (gitignored), fill
# in your own values, then add them in the Render dashboard (Service > Environment)
# or paste into render.yaml's envVars block.
#
# Render does NOT auto-read a `.env` file; these values must be added to the
# service's Environment variables in the Render dashboard (or render.yaml).
# ============================================================================

# --- Basic / required ---
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/financily
CLIENT_ORIGIN=https://your-site.vercel.app,https://financily-94e0.onrender.com
JWT_SECRET=CHANGE-ME-long-random-string
ADMIN_USER=admin
ADMIN_PASS=CHANGE-ME-strong-password

# --- OCR (required if you use the loan-application image OCR) ---
# Firebase service-account JSON, compressed to a single line. Generate from
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT=PASTE-ONE-LINE-JSON-HERE
# FreeOCR API key (https://freeocr.ai)
FREEOCR_API_KEY=PASTE-FREEOCR-KEY-HERE

# --- Email OTP + notifications (optional — Brevo HTTP API) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME=Financily
NOTIFY_EMAIL=

# --- SMS OTP (optional — Fast2SMS; only if NOT using Firebase Phone Auth) ---
FAST2SMS_KEY=

# --- SMTP fallback (optional — blocked on Render free tier) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
